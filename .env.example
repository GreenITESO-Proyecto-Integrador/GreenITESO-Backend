# Local-only disposable values. Never use this file for staging or production.
DJANGO_ENV=dev
DJANGO_DEPLOYED=false
DJANGO_CONNECTION_ROLE=app
DJANGO_SECRET_KEY=local-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app

# Host commands use 127.0.0.1; the app service overrides the host to `db` in compose.yaml.
POSTGRES_DB=greeniteso
POSTGRES_USER=greeniteso
POSTGRES_PASSWORD=greeniteso-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://greeniteso:greeniteso-local-password@127.0.0.1:5432/greeniteso
# Direct URL is used by migrations and administrative tasks. Local development has no pooler.
DATABASE_URL_UNPOOLED=postgresql://greeniteso:greeniteso-local-password@127.0.0.1:5432/greeniteso
